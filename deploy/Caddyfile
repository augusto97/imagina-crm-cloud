# Caddyfile de producción — Imagina Base
#
# Un solo origen (mismo dominio) sirve los dos SPA y proxya el API + realtime al
# backend NestJS. Al ser mismo origen no hay CORS y la cookie de sesión httpOnly
# viaja sin problemas. Caddy resuelve HTTPS automáticamente (Let's Encrypt).
#
# Reemplazá `app.tu-dominio.com` por tu dominio real y apuntá su DNS (A/AAAA) a
# la IP del VPS ANTES de arrancar Caddy (necesita validar el certificado).
#
# ── Dominios personalizados por empresa (ADR-S17) ───────────────────────────
# `on_demand_tls` emite el certificado de un dominio la PRIMERA vez que alguien
# lo visita, preguntándole antes al API si ese dominio pertenece a un tenant
# (`ask` → 200 emite / 404 rechaza). Así un cliente apunta su CNAME a
# `app.tu-dominio.com`, lo registra en Ajustes → Marca, y su dominio queda
# vivo con HTTPS sin tocar el servidor.
#
# Subdominios automáticos (`slug.app.tu-dominio.com`): apuntá también el DNS
# wildcard `*.app.tu-dominio.com` (A/AAAA) a la IP del VPS; el mismo bloque
# on-demand los sirve (el `ask` valida el slug contra la DB).

{
    on_demand_tls {
        ask http://127.0.0.1:3001/api/v1/public/domains/check
    }
}

# Bloque común: API + los dos SPA (mismo layout para todos los hostnames).
(imagina_app) {
    encode zstd gzip

    # --- Backend: API REST + webhooks + WebSocket del realtime ---
    handle /api/* {
        reverse_proxy 127.0.0.1:3001
    }
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:3001
    }

    # Raíz = el SPA del release activo (layout de releases atómicos, ADR-S13):
    # `current` es un symlink al release vivo; un update lo cambia y Caddy sirve
    # el SPA nuevo al instante (sigue el symlink en cada request). Ambos builds
    # referencian sus bundles bajo /assets/*, que se sirven tal cual.
    root * /opt/imagina-base/current/web

    # Portal del cliente (build separado): fallback SPA a su index.
    handle /portal* {
        try_files {path} /cloud-portal/index.html
        file_server
    }

    # Resto (/, /lists, /settings, …): fallback SPA al shell cloud.
    handle {
        try_files {path} /cloud/index.html
        file_server
    }

    # HSTS: vale para TODO el host (incluido el API).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Cabeceras de ENCUADRE y CSP: SÓLO para el SPA, nunca para `/api/*`.
    #
    # OJO (v0.1.113): el API emite sus PROPIAS políticas y son incompatibles
    # con las del SPA —
    #   · `/api/v1/public/l/:token` (lista pública embebible, ADR-S14) manda
    #     `frame-ancestors` con los dominios que autorizó el tenant; un
    #     `X-Frame-Options: SAMEORIGIN` o un segundo CSP con
    #     `frame-ancestors 'self'` lo bloquearían (el navegador aplica la
    #     INTERSECCIÓN de las dos políticas) y el iframe del cliente moriría.
    #   · Las descargas de archivos mandan `Content-Security-Policy: sandbox`.
    # Por eso el matcher excluye el API.
    @spa not path /api/*
    header @spa {
        X-Frame-Options "SAMEORIGIN"
        # CSP (v0.1.113) — defensa en profundidad; ver deploy/nginx.conf para
        # el detalle de por qué cada directiva es como es (inline de scripts
        # por el pre-pintado del tema, inline de estilos por Radix y el
        # page-builder, data:/blob: por los previews de imágenes).
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
}

# Dominio principal de la plataforma (certificado normal de Let's Encrypt).
app.tu-dominio.com {
    import imagina_app
}

# Dominios personalizados + subdominios de empresas: certificado on-demand,
# gateado por el endpoint `ask` de arriba (solo dominios registrados).
https:// {
    tls {
        on_demand
    }
    import imagina_app
}
