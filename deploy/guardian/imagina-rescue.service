[Unit]
Description=Página de rescate de Imagina Base (puerto propio, con clave)
After=network-online.target
Wants=network-online.target

[Service]
# Arranca como root sólo para leer el certificado del dominio y abrir su puerto;
# enseguida pasa al usuario imagina-rescue (sin permisos). Lo instala
# deploy/install-guardian.sh; el guardián lo vigila y lo reinicia si se cae.
Type=simple
Environment=RESCUE_CONF=@CONF@
ExecStart=@NODE@ @LIB@/imagina-rescue.mjs serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=@STATE@/rescue
ProtectHome=@PROTECT_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
