#!/usr/bin/env bash
# Dice en palabras cómo está el servidor. No arregla nada. Como root:
#   imagina-estado
# (Lo instala deploy/install-guardian.sh en /usr/local/bin. v0.1.432, ADR-S104.)
set -uo pipefail
LIB="${GUARDIAN_LIB:-@LIB@}"
if [ "$(id -u)" -ne 0 ] && [ "${GUARDIAN_TEST:-}" != 1 ]; then
    echo "Córrelo como root: sudo imagina-estado"
    exit 1
fi
case "${1:-}" in
    -h|--help|ayuda) echo "Uso: imagina-estado    (dice cómo está el servidor; para arreglar: imagina-reparar)"; exit 0 ;;
    '') ;;
    *) echo "imagina-estado no lleva opciones. Para arreglar: imagina-reparar"; exit 2 ;;
esac
exec bash "$LIB/imagina-guardian.sh" --check --human
