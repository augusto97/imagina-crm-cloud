# ── .env.production — copia a /opt/imagina-base/.env.production y completa ──
# Lo usan TANTO docker-compose.prod.yml (Postgres/Redis) COMO el API (systemd).
# NO lo commitees con valores reales. Genera secrets con: openssl rand -hex 32

# --- Postgres/Redis (los consume docker-compose.prod.yml) ---
POSTGRES_USER=imagina
POSTGRES_PASSWORD=CAMBIAR_password_fuerte
POSTGRES_DB=imagina_base
REDIS_PASSWORD=CAMBIAR_password_fuerte

# --- API (los consume el proceso NestJS) ---
NODE_ENV=production
PORT=3001
# Deben coincidir con las credenciales de arriba (los env files NO interpolan).
DATABASE_URL=postgres://imagina:CAMBIAR_password_fuerte@127.0.0.1:5432/imagina_base
REDIS_URL=redis://:CAMBIAR_password_fuerte@127.0.0.1:6379
SESSION_TTL_SECONDS=2592000
# Detrás de HTTPS (Caddy) → cookie segura obligatoria.
COOKIE_SECURE=true
# URL pública del SPA (para links absolutos en emails / retorno de pagos).
APP_BASE_URL=https://app.tu-dominio.com

# En QUÉ proxy se confía para leer X-Forwarded-*. `loopback` = el Caddy/nginx
# de esta misma máquina, que es el despliegue de este repo. De aquí salen el IP
# del rate limit, el que se muestra en "Dispositivos conectados" y el host del
# que se deriva el issuer OAuth: confiar en toda la cadena (`true`) deja que un
# cliente directo se la invente. Si hay otra capa por delante (p. ej. Cloudflare)
# pon sus rangos separados por coma, no un número.
TRUST_PROXY=loopback

# Conexiones a Postgres por proceso (API + workers comparten el pool). Default 20.
# DB_POOL_MAX=30
# Automatizaciones que corren a la vez en este proceso (1-100). Default 10.
# Cada una toma como mucho una conexión de la base mientras escribe (la red
# —webhooks, correos, WhatsApp— se espera fuera de la transacción). Si se
# sube, conviene que DB_POOL_MAX quede al menos en el doble.
# AUTOMATIONS_CONCURRENCY=10
# Cuántas automatizaciones pueden encadenarse (A cambia un registro → corre B →
# B cambia otro → corre C…) antes de que los cambios dejen de disparar otras
# (1-10). Default 3. Una automatización nunca corre dos veces en la misma cadena.
# AUTOMATIONS_MAX_CHAIN_DEPTH=3
# Buzones de la mesa de ayuda que se leen a la vez en este proceso (1-50). Default 8.
# HELPDESK_POLL_CONCURRENCY=8
# Topes de tiempo en Postgres (ms; 0 = sin tope). Una sentencia que pasa del
# tope se cancela (503); una transacción abierta sin hacer nada se corta.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TX_TIMEOUT_MS=120000
# JIT de Postgres apagado por defecto (consultas cortas: compilar cuesta más de lo que ahorra). "on" lo prende.
# DB_JIT=off
# Tope por comando del cliente Redis principal (ms): con Redis colgado, los
# pedidos fallan en vez de quedar esperando.
# REDIS_COMMAND_TIMEOUT_MS=2000


# --- Email (ADR-S11). log = no envía; smtp = real ---
MAIL_TRANSPORT=smtp
MAIL_FROM="Imagina Base <no-reply@tu-dominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Pagos (ADR-S12). Vacío = proveedor deshabilitado ---
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# v0.1.250: se cargan mejor desde Plataforma → Cobros (cifradas); esto es el respaldo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Billing webhook stand-in (opcional; vacío = deshabilitado) ---
BILLING_WEBHOOK_SECRET=

# --- Superadmin de plataforma + auto-actualización (ADR-S13) ---
# Emails (coma-separados) que pueden operar la auto-actualización del servidor.
PLATFORM_SUPERADMINS=tu-correo@tu-dominio.com
# Repo de GitHub a consultar por releases nuevos.
UPDATER_GITHUB_REPO=augusto97/imagina-crm-cloud
UPDATER_CHANNEL=stable
# Token de solo-lectura (repo:read) — SÓLO si el repo es privado. Público = vacío.
UPDATER_GITHUB_TOKEN=
# Raíz del layout de releases atómicos (DOS niveles arriba del app root).
UPDATER_BASE_PATH=/opt/imagina-base
UPDATER_KEEP_RELEASES=5

# --- Secretos de la app (OBLIGATORIOS en producción; el arranque falla sin ellos) ---
# Cifrado en reposo de credenciales (SMTP por empresa, 2FA, conectores, IA).
# Generar con: openssl rand -hex 32  — NO cambiarla después (lo cifrado queda ilegible).
SECRETS_KEY=
# Firma de las URLs de archivos (portal, logo del white-label). openssl rand -hex 32
FILES_SIGNING_SECRET=

# --- Métricas (v0.1.226) ---
# OPCIONAL. Token Bearer para GET /api/v1/metrics — sólo hace falta si tienes un
# scraper (Prometheus, Grafana Agent). Vacío en producción = endpoint cerrado
# (403), que es lo correcto si nadie lo consulta. La app no lo usa para nada.
METRICS_TOKEN=

# --- SMTP propio de las empresas (v0.1.226) ---
# Por defecto el SMTP de una empresa sólo puede apuntar a servidores públicos.
# `true` sólo si tus clientes usan un relay de TU red interna a propósito.
SMTP_ALLOW_PRIVATE_HOSTS=false

# --- Bases de datos de las empresas (SQL Server / Azure SQL, v0.1.243) ---
# Igual que el SMTP: sólo servidores públicos. `true` sólo si tus clientes
# sincronizan desde una base de TU red interna a propósito.
SQL_ALLOW_PRIVATE_HOSTS=false
# Almacenamiento propio de las empresas (bucket S3): sólo direcciones públicas
# salvo que pongas true (un MinIO de tu red interna).
STORAGE_ALLOW_PRIVATE_HOSTS=false

# Separar el API de los trabajos en segundo plano (v0.1.405). Con WORKERS=off
# este proceso atiende pedidos pero no toma trabajos ni registra tareas
# periódicas: hace falta OTRO proceso con WORKERS=on (el valor por defecto).
# WORKERS=on
# Cuánto se espera a los trabajos en curso al apagar (ms). Debe quedar por
# debajo del TimeoutStopSec de la unidad de systemd.
# WORKERS_DRAIN_MS=14000
