# ── .env.production — copiá a /opt/imagina-base/.env.production y completá ──
# Lo usan TANTO docker-compose.prod.yml (Postgres/Redis) COMO el API (systemd).
# NO lo commitees con valores reales. Generá secrets con: openssl rand -hex 32

# --- Postgres/Redis (los consume docker-compose.prod.yml) ---
POSTGRES_USER=imagina
POSTGRES_PASSWORD=CAMBIAR_password_fuerte
POSTGRES_DB=imagina_base
REDIS_PASSWORD=CAMBIAR_password_fuerte

# --- API (los consume el proceso NestJS) ---
NODE_ENV=production
PORT=3001
# Deben coincidir con las credenciales de arriba (los env files NO interpolan).
DATABASE_URL=postgres://imagina:CAMBIAR_password_fuerte@127.0.0.1:5432/imagina_base
REDIS_URL=redis://:CAMBIAR_password_fuerte@127.0.0.1:6379
SESSION_TTL_SECONDS=2592000
# Detrás de HTTPS (Caddy) → cookie segura obligatoria.
COOKIE_SECURE=true
# URL pública del SPA (para links absolutos en emails / retorno de pagos).
APP_BASE_URL=https://app.tu-dominio.com

# En QUÉ proxy se confía para leer X-Forwarded-*. `loopback` = el Caddy/nginx
# de esta misma máquina, que es el despliegue de este repo. De acá salen el IP
# del rate limit, el que se muestra en "Dispositivos conectados" y el host del
# que se deriva el issuer OAuth: confiar en toda la cadena (`true`) deja que un
# cliente directo se la invente. Si hay otra capa por delante (p. ej. Cloudflare)
# poné sus rangos separados por coma, no un número.
TRUST_PROXY=loopback

# --- Email (ADR-S11). log = no envía; smtp = real ---
MAIL_TRANSPORT=smtp
MAIL_FROM="Imagina Base <no-reply@tu-dominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Pagos (ADR-S12). Vacío = proveedor deshabilitado ---
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Billing webhook stand-in (opcional; vacío = deshabilitado) ---
BILLING_WEBHOOK_SECRET=

# --- Superadmin de plataforma + auto-actualización (ADR-S13) ---
# Emails (coma-separados) que pueden operar la auto-actualización del servidor.
PLATFORM_SUPERADMINS=vos@tu-dominio.com
# Repo de GitHub a consultar por releases nuevos.
UPDATER_GITHUB_REPO=augusto97/imagina-crm-cloud
UPDATER_CHANNEL=stable
# Token de solo-lectura (repo:read) — SÓLO si el repo es privado. Público = vacío.
UPDATER_GITHUB_TOKEN=
# Raíz del layout de releases atómicos (DOS niveles arriba del app root).
UPDATER_BASE_PATH=/opt/imagina-base
UPDATER_KEEP_RELEASES=5

# --- Secretos de la app (OBLIGATORIOS en producción; el arranque falla sin ellos) ---
# Cifrado en reposo de credenciales (SMTP por empresa, 2FA, conectores, IA).
# Generar con: openssl rand -hex 32  — NO cambiarla después (lo cifrado queda ilegible).
SECRETS_KEY=
# Firma de las URLs de archivos (portal, logo del white-label). openssl rand -hex 32
FILES_SIGNING_SECRET=

# --- Métricas (v0.1.226) ---
# Token Bearer para GET /api/v1/metrics. Vacío en producción = endpoint cerrado.
METRICS_TOKEN=

# --- SMTP propio de las empresas (v0.1.226) ---
# Por defecto el SMTP de una empresa sólo puede apuntar a servidores públicos.
# `true` sólo si tus clientes usan un relay de TU red interna a propósito.
SMTP_ALLOW_PRIVATE_HOSTS=false
