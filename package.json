{
    "name": "imagina-base",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "infra:up": "docker compose -f docker/docker-compose.yml up -d --wait",
        "infra:down": "docker compose -f docker/docker-compose.yml down",
        "db:generate": "pnpm --filter @imagina-base/api db:generate",
        "db:migrate": "pnpm --filter @imagina-base/api db:migrate"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.0",
        "eslint": "^9.30.0",
        "playwright-core": "1.64.1",
        "turbo": "^2.5.4",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.35.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "argon2",
            "esbuild",
            "@nestjs/core",
            "cpu-features",
            "ssh2",
            "protobufjs",
            "unrs-resolver"
        ],
        "overrides": {
            "ioredis": "5.11.1",
            "@babel/runtime": ">=7.26.10",
            "fast-uri": ">=4.2.3",
            "dompurify": ">=3.4.17",
            "find-my-way": ">=9.7.0",
            "postcss": ">=8.5.23",
            "brace-expansion@1": "1.1.20",
            "brace-expansion@2": "2.1.6",
            "nanoid": ">=3.3.18",
            "socket.io-parser": ">=4.2.7",
            "engine.io": ">=6.6.11",
            "@tiptap/core": ">=3.30.5",
            "fastify": ">=5.12.6",
            "hono": ">=4.13.11",
            "ip-address": ">=10.7.4",
            "@fastify/busboy": ">=3.2.2",
            "source-map-js": ">=1.2.2",
            "prosemirror-model": "1.25.12",
            "body-parser": ">=2.4.0"
        },
        "auditConfig": {
            "ignoreGhsas": [
                "GHSA-hp3w-g68c-fv3c",
                "GHSA-xcx6-jx8p-x3h5",
                "GHSA-mrhx-c7xc-m3w5"
            ]
        }
    }
}
